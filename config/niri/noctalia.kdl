layout {

    focus-ring {
        active-color   "#c8cd5a"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#c8cd5a"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#c8cd5a"
        inactive-color "#474a00"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#c8cd5a80"
    }
}

recent-windows {
    highlight {
        active-color "#c8cd5a"
        urgent-color "#ffb4ab"
    }
}
